# PostgreSQL password (default: holodos — change in production!)
POSTGRES_PASSWORD=holodos

# Address the backend port 8080 is published on (default 127.0.0.1).
# Use the server's LAN address to reach the UI from other devices, e.g. 10.100.102.28
HOLODOS_BIND_ADDRESS=

# Google login (required)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Allowed CORS origins (comma-separated). Leave empty: the web UI is served from the same origin.
# Set only if another site must call the API, e.g. https://holodos.example.com
HOLODOS_CORS_ALLOWED_ORIGINS=

# Google Tasks OAuth2 (optional, leave empty to disable)
GOOGLE_TASKS_CLIENT_ID=
GOOGLE_TASKS_CLIENT_SECRET=
GOOGLE_TASKS_REDIRECT_URI=

# OpenAI (optional): guesses category, unit, storage place and shelf life when a product
# is added by name. Disabled -> the first category/place and "piece" are used instead.
OPENAI_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
# reasoning.effort sent to the model; leave empty for models without reasoning controls
OPENAI_REASONING_EFFORT=none
